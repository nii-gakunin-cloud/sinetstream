# syntax=docker/dockerfile:1
# check=skip=SecretsUsedInArgOrEnv
FROM debian:trixie-20260316 AS base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get -y install --no-install-recommends \
      openjdk-21-jdk-headless \
      python3 \
      python3-pip \
      mosquitto \
      supervisor \
      curl \
      gzip \
      ca-certificates \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -m 0700 /var/run/supervisor

# Install Apache Kafka
ARG KAFKA_VERSION=4.2.0
RUN curl -sO https://downloads.apache.org/kafka/${KAFKA_VERSION}/kafka_2.13-${KAFKA_VERSION}.tgz \
 && curl -s https://downloads.apache.org/kafka/${KAFKA_VERSION}/kafka_2.13-${KAFKA_VERSION}.tgz.sha512 \
      | tr -d ' \n' | sed 's/.*://' \
      | xargs -I{} echo "{}  kafka_2.13-${KAFKA_VERSION}.tgz" \
      | sha512sum -c - \
 && tar xzf kafka_2.13-${KAFKA_VERSION}.tgz -C /srv \
 && mv /srv/kafka_2.13-${KAFKA_VERSION} /srv/kafka \
 && rm kafka_2.13-${KAFKA_VERSION}.tgz

# Project license files
COPY LICENSE NOTICE /opt/licenses/

# --- Tutorial image ---
FROM base AS tutorial
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get -y install --no-install-recommends \
      openssh-server \
      openssh-client \
      vim \
      iproute2 \
      procps \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && rm -f /etc/ssh/ssh_host_*

COPY scripts/tutorial/supervisord.conf /etc/supervisor/supervisord.conf

# Add user
ARG USERNAME=user01
RUN useradd -m $USERNAME
WORKDIR /home/${USERNAME}

EXPOSE 9092 1883
ENV ENABLE_BROKER=true \
    ENABLE_SSHD=false

COPY scripts/tutorial/init-debian.sh /usr/local/bin/init.sh
ENTRYPOINT ["/usr/local/bin/init.sh"]

# --- CI test image ---
FROM base AS ci

RUN apt-get update \
 && apt-get -y install --no-install-recommends openssl \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

COPY scripts/ci/supervisord.conf /etc/supervisor/supervisord.conf

EXPOSE 9092 9093 1883 8883 8080
ENV ENABLE_BROKER=true \
    ENABLE_SSL=true \
    GENERATE_CLIENT_CERTS=true \
    SSL_CLIENT_AUTH=requested

COPY scripts/ci/init-debian.sh /usr/local/bin/init.sh
ENTRYPOINT ["/usr/local/bin/init.sh"]
